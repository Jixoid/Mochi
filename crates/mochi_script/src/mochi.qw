pub struct Vec3 {
	pub x: f32;
	pub y: f32;
	pub z: f32;
}


![C, import]
pub fun mochi_get_position(entity: u64, out_pos: &mut Vec3);

![C, import]
pub fun mochi_set_position(entity: u64, in_pos: &Vec3);

![C, import]
pub fun mochi_rotate(entity: u64, dx: f32, dy: f32, dz: f32);

![C, import]
pub fun mochi_move_relative(entity: u64, forward: f32, right: f32, up: f32);

![C, import]
pub fun mochi_camera_look(entity: u64, pitch: f32, yaw: f32);

![C, import]
pub fun mochi_get_scale(entity: u64, out_scale: &mut Vec3);

![C, import]
pub fun mochi_set_scale(entity: u64, in_scale: &Vec3);

![C, import]
pub fun mochi_is_key_down(keycode: i32) -> bool;

![C, import]
pub fun mochi_is_key_just_pressed(keycode: i32) -> bool;

![C, import]
pub fun mochi_is_mouse_button_down(button: i32) -> bool;

![C, import]
pub fun mochi_get_mouse_delta(out_dx: &mut f32, out_dy: &mut f32);

![C, import]
pub fun mochi_get_mouse_wheel() -> f32;

![C, import]
pub fun mochi_get_camera_speed() -> f32;

![C, import]
pub fun mochi_set_camera_speed(speed: f32);

![C, import]
pub fun mochi_get_time() -> f32;

![C, import]
pub fun mochi_set_msaa(samples: i32);

![C, import]
pub fun mochi_get_msaa() -> i32;

![C, import]
pub fun mochi_set_aa_mode(mode: i32);

![C, import]
pub fun mochi_get_aa_mode() -> i32;

![C, import]
pub fun mochi_set_frame_generation(enabled: bool);

![C, import]
pub fun mochi_is_frame_generation_enabled() -> bool;

![C, import]
pub fun mochi_has_spot_light(entity: u64) -> bool;

![C, import]
pub fun mochi_get_spot_light_intensity(entity: u64) -> f32;

![C, import]
pub fun mochi_set_spot_light_intensity(entity: u64, intensity: f32);

![C, import]
pub fun mochi_get_spot_light_radius(entity: u64) -> f32;

![C, import]
pub fun mochi_set_spot_light_radius(entity: u64, radius: f32);

![C, import]
pub fun mochi_get_spot_light_cone(entity: u64, out_inner_deg: &mut f32, out_outer_deg: &mut f32);

![C, import]
pub fun mochi_set_spot_light_cone(entity: u64, inner_deg: f32, outer_deg: f32);

![C, import]
pub fun mochi_has_point_light(entity: u64) -> bool;

![C, import]
pub fun mochi_get_point_light_intensity(entity: u64) -> f32;

![C, import]
pub fun mochi_set_point_light_intensity(entity: u64, intensity: f32);

![C, import]
pub fun mochi_get_point_light_radius(entity: u64) -> f32;

![C, import]
pub fun mochi_set_point_light_radius(entity: u64, radius: f32);

![C, import]
pub fun mochi_set_cursor_captured(captured: bool);

![C, import]
pub fun mochi_is_cursor_captured() -> bool;

![C, import]
pub fun mochi_toggle_cursor_capture();

styles {
  toolbar_title {
    font_size: 14
  }
  panel_title {
    font_size: 13
  }
  subtitle {
    font_size: 12
  }
  hud_text {
    font_size: 12
  }
}

root qstd::vbox {
  spacing: 6
  paddings: 6
  color: "monet(SurfaceContainerLowest)"

  // Top MenuBar
  node qstd::menubar "editor_menubar" {
    anchor: "top-fill"
    on_action: "OnMenuAction"
    items: [
      {
        text: "Dosya",
        items: [
          { text: "Kaydet", shortcut: "Ctrl+S", action: "FileSave" },
          "-",
          { text: "Welcome Hub'a Dön", action: "FileBackToHub" }
        ]
      },
      {
        text: "Düzenle",
        items: [
          { text: "Geri Al", shortcut: "Ctrl+Z", action: "EditUndo" },
          { text: "Yinele", shortcut: "Ctrl+Y", action: "EditRedo" },
          "-",
          { text: "Seçili Entity'yi Kopyala", shortcut: "Ctrl+D", action: "EditDuplicateEntity" },
          { text: "Seçili Entity'yi Sil", shortcut: "Del", action: "EditDeleteEntity" }
        ]
      },
      {
        text: "Oluştur",
        items: [
          { text: "Boş Entity", action: "CreateEmpty" },
          "-",
          { text: "Directional Light", action: "CreateDirLight" },
          { text: "Point Light", action: "CreatePointLight" },
          { text: "Spot Light", action: "CreateSpotLight" },
          "-",
          { text: "Kamera", action: "CreateCamera" },
          { text: "Fizik Küpü", action: "CreatePhysicsCube" }
        ]
      },
      {
        text: "Görünüm",
        items: [
          { text: "Seçili Nesneye Odaklan", shortcut: "F", action: "ViewFocusSelected" },
          "-",
          { text: "Izgara Göster / Gizle", action: "ViewToggleGrid" },
          { text: "Işık & Kamera İkonları", action: "ViewToggleGizmos" },
          { text: "Tüm Collider'ları Göster", action: "ViewToggleColliders" },
          "-",
          {
            text: "Tema Modu",
            items: [
              { text: "Koyu Tema", action: "ViewThemeDark" },
              { text: "Açık Tema", action: "ViewThemeLight" }
            ]
          },
          {
            text: "Köşe Stili",
            items: [
              { text: "Kompakt (Editör)", action: "ViewRadiusCompact" },
              { text: "Yuvarlatılmış", action: "ViewRadiusRounded" }
            ]
          }
        ]
      },
      {
        text: "Sahne",
        items: [
          { text: "Sahneyi Çalıştır", shortcut: "F5", action: "ScenePlay" }
        ]
      }
    ]
  }

  // Primary Toolbar
  node qstd::hbox {
    spacing: 8
    paddings: 6
    color: "monet(SurfaceContainerLow)"
    corner_radius: 8
    anchor: "top-fill"

    node qstd::button {
      text: "← Hub"
      variant: "outlined"
      on_click: "EditorBackToHub"
    }

    node qstd::text "editor_scene_title" {
      style: "toolbar_title"
      text: "Sahne"
      anchor: "left-center"
      color: "monet(PrimaryFixed)"
    }

    node qstd::spacer {
      anchor: "fill"
    }

    node qstd::choice {
      tabs: ["Translate", "Rotate", "Scale"]
      on_changed: "GizmoModeChanged"
    }

    node qstd::choice {
      tabs: ["World", "Local"]
      on_changed: "GizmoSpaceChanged"
    }

    node qstd::check {
      text: "Snap"
      checked: false
      on_changed: "GizmoSnapChanged"
    }

    node qstd::spacer {
      width: 6
    }

    node qstd::button {
      text: "Kaydet"
      variant: "tonal"
      on_click: "EditorSaveScene"
    }

    node qstd::button {
      text: "▶ Çalıştır"
      variant: "filled"
      on_click: "EditorPlayScene"
    }
  }

  // Dockable Workspace
  node dock::area "editor_dock" {
    anchor: "fill"
    splitter_size: 6
    tab_bar_height: 28
    on_pane_closed: "OnDockPaneClosed"

    // Center: 3D Viewport
    node dock::pane {
      title: "3B Viewport"
      slot: "center"
      closable: false
      paddings: 0

      node qstd::viewport "main_viewport" {
        anchor: "fill"
        corner_radius: 0
        on_resize: "ViewportResized"
        on_pointer_down: "ViewportPointerDown"
        on_pointer_up: "ViewportPointerUp"
        on_pointer_move: "ViewportPointerMove"
        on_scroll: "ViewportScroll"

        node gizmo::transform "viewport_transform_gizmo" {
          anchor: "fill"
          mode: "translate"
          space: "world"
          on_changed: "GizmoTransformChanged"
        }

        node gizmo::orientation "viewport_orientation_gizmo" {
          anchor: "right-top"
          size: 86
          margin: 10
          on_snap: "GizmoCameraSnap"
          on_orbit: "GizmoCameraOrbit"
        }

        node qstd::card {
          paddings: 8
          corner_radius: 6
          anchor: "left-top"
          color: "monet(SurfaceContainer)"

          node qstd::text "viewport_hud" {
            style: "hud_text"
            text: "Viewport • Hazır"
            color: "monet(OnSurface)"
          }
        }

        node qstd::card "viewport_loading" {
          paddings: 14
          corner_radius: 10
          anchor: "center"
          color: "monet(SurfaceContainerHigh)"

          node qstd::vbox {
            spacing: 10
            color: "color(transparent)"

            node qstd::spinner {
              size: 32
              thickness: 3.5
              anchor: "top-center"
            }

            node qstd::text {
              style: "hud_text"
              text: "3B Sahne Yükleniyor..."
              anchor: "top-center"
              color: "monet(OnSurfaceVariant)"
            }
          }
        }

        node qstd::card {
          paddings: 6
          corner_radius: 6
          anchor: "left-bottom"
          color: "monet(SurfaceContainer)"

          node qstd::text "viewport_camera_hud" {
            style: "hud_text"
            text: "Orbit: Yaw 25.0° Pitch 20.0° Zoom 10.0"
            color: "monet(OnSurfaceVariant)"
          }
        }
      }
    }

    // Bottom: Asset Browser
    node dock::pane {
      title: "İçerik Tarayıcı"
      slot: "bottom"
      paddings: 8

      node qstd::vbox "asset_browser_list" {
        anchor: "fill"
        spacing: 4
        color: "color(transparent)"
        scrollable: true
      }
    }

    // Bottom: Console
    node dock::pane {
      title: "Konsol"
      slot: "bottom"
      paddings: 8

      node qstd::vbox "console_log_list" {
        anchor: "fill"
        spacing: 4
        color: "color(transparent)"
        scrollable: true
      }
    }

    // Left: Scene Hierarchy (qstd::treeview)
    node dock::pane {
      title: "Hiyerarşi"
      slot: "left"
      closable: false
      paddings: 8

      node qstd::vbox {
        anchor: "fill"
        spacing: 6
        color: "color(transparent)"

        node qstd::hbox {
          spacing: 6
          anchor: "top-fill"
          color: "color(transparent)"

          node qstd::edit "hierarchy_search" {
            title: "Entity ara..."
            anchor: "fill"
            on_changed: "OnHierarchySearch"
          }

          node qstd::button {
            text: "+ Ekle"
            variant: "tonal"
            on_click: "EditorAddEntity"
          }
        }

        node qstd::treeview "hierarchy_tree" {
          anchor: "fill"
          draggable: true
          row_height: 26
          on_selected: "OnHierarchySelected"
        }
      }
    }

    // Right: Inspector
    node dock::pane {
      title: "Inspector"
      slot: "right"
      closable: false
      paddings: 8

      node qstd::vbox {
        anchor: "fill"
        spacing: 8
        color: "color(transparent)"
        scrollable: true

        node qstd::hbox {
          spacing: 8
          anchor: "top-fill"
          color: "color(transparent)"

          node qstd::text {
            style: "panel_title"
            text: "Bileşenler"
            anchor: "fill"
            color: "monet(OnSurfaceVariant)"
          }

          node qstd::button "btn_delete_entity" {
            text: "Sil"
            variant: "outlined"
            on_click: "EditorDeleteEntity"
          }
        }

        node qstd::vbox "inspector_content" {
          spacing: 8
          anchor: "top-fill"
          color: "color(transparent)"
        }
      }
    }
  }

  // Bottom Status Bar
  node qstd::hbox {
    spacing: 12
    paddings: 6
    color: "monet(SurfaceContainerLow)"
    corner_radius: 6
    anchor: "bottom-fill"

    node qstd::text "editor_status_text" {
      style: "subtitle"
      text: "Hazır"
      anchor: "fill"
      color: "monet(OnSurfaceVariant)"
    }

    node qstd::text "editor_viewport_size" {
      style: "subtitle"
      text: "Viewport: 0x0"
      anchor: "right-center"
      color: "monet(OnSurfaceVariant)"
    }
  }
}
